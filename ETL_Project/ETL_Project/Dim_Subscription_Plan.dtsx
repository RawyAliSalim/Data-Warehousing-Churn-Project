                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[UPPER]([SUBSTRING](#{Package\ETL Dim_Subscription_Plan\Union All.Outputs[Union All Output 1].Columns[Subscription Type]},1,1)) + [LOWER]([SUBSTRING](#{Package\ETL Dim_Subscription_Plan\Union All.Outputs[Union All Output 1].Columns[Subscription Type]},2,[LEN](#{Package\ETL Dim_Subscription_Plan\Union All.Outputs[Union All Output 1].Columns[Subscription Type]}))) + " " + [LOWER](#{Package\ETL Dim_Subscription_Plan\Union All.Outputs[Union All Output 1].Columns[Contract Length]})</property>
