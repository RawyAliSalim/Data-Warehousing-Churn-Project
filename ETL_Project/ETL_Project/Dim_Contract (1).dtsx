                      length="30"
                      lineageId="Package\Load Dim Contract\Derived Column.Outputs[Derived Column Output].Columns[Contract_Name]"
                      name="Contract_Name"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[UPPER]([SUBSTRING](#{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]},1,1)) + [LOWER]([SUBSTRING](#{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]},2,[LEN](#{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]})))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">UPPER(SUBSTRING(Contract_Type,1,1)) + LOWER(SUBSTRING(Contract_Type,2,LEN(Contract_Type)))</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Load Dim Contract\Derived Column.Outputs[Derived Column Output].Columns[Contract_Code]"
