                    </outputColumn>
                    <outputColumn
                      refId="Package\Load Dim Contract\Derived Column.Outputs[Derived Column Output].Columns[Contract_Months]"
                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Load Dim Contract\Derived Column.Outputs[Derived Column Output].Columns[Contract_Months]"
                      name="Contract_Months"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">#{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "Monthly" || #{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "Month-to-month" ? 1 : #{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "Quarterly" ? 3 : #{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "Annual" || #{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "One year" ? 12 : #{Package\Load Dim Contract\OLE DB Source.Outputs[OLE DB Source Output].Columns[Contract_Type]} == "Two year" ? 24 : 0</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">Contract_Type == "Monthly" || Contract_Type == "Month-to-month" ? 1 : Contract_Type == "Quarterly" ? 3 : Contract_Type == "Annual" || Contract_Type == "One year" ? 12 : Contract_Type == "Two year" ? 24 : 0</property>
